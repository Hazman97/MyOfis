# ---------- Hub ----------
HUB_PORT=8787
HUB_HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:8787
AUTH_MODE=local            # local | cf-access (Cloudflare Access; see docs/cloudflare-tunnel.md)
LOCAL_AUTH_TOKEN=change-me
# 32+ random chars. Encrypts provider API keys at rest and signs session cookies.
# Generate: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SECRETS_KEY=change-me-to-a-long-random-string
CF_ACCESS_TEAM_DOMAIN=     # e.g. yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
OWNER_EMAIL=
# Optional: comma-separated Cloudflare Access Service Token client IDs (e.g. xxxx.access) allowed to act as the owner's assistant (test/read access, deny-listed from secrets and admin actions). Empty = off.
OWNER_SERVICE_TOKENS=
DATABASE_PATH=./data/agent-office.db
FILES_DIR=./data/files
WORKSPACES_DIR=./workspaces
# Office view art (Tiled map, tileset, sprite atlases). Rebuild with: bun run --cwd apps/web office:assets
MAPS_DIR=./maps
# Project briefs (brief.yaml) and FEATURES.md, one folder per project slug.
PROJECTS_DIR=./projects
# Skills agents learn (SKILL.md, agentskills.io format; the owner approves each one)
SKILLS_DIR=./skills
# Provider keys can also be entered in the web UI (Settings -> Providers).
# Values here are used to seed providers on first boot only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Telegram (optional): approvals with buttons, morning reports, failures. Can also be set in Settings -> Integrations.
# Create a bot with @BotFather; send /id to your bot to see your chat id. Values here seed the settings on first boot only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
GITEA_URL=
GITEA_TOKEN=
TZ=Asia/Kuala_Lumpur
# Vite dev server port (bun run dev). It proxies to the hub on HUB_PORT.
WEB_DEV_PORT=5180

# ---------- Runner (can live in a separate .env on another machine) ----------
HUB_URL=http://127.0.0.1:8787
RUNNER_NAME=main-pc
RUNNER_TOKEN=
PAIRING_CODE=
RUNNER_STATE_PATH=./data/runner-state.json
# Runner on another machine behind Cloudflare Access: the Access service token (docs/cloudflare-tunnel.md)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
