{
  "name": "agent-office",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n hub,web -c blue,green \"bun run dev:hub\" \"bun run dev:web\"",
    "dev:hub": "bun --watch apps/hub/src/index.ts",
    "dev:runner": "bun --watch apps/runner/src/index.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "start:hub": "bun apps/hub/src/index.ts",
    "start:runner": "bun apps/runner/src/index.ts",
    "build": "bun run --cwd apps/web build",
    "test": "bun test",
    "typecheck": "tsc -p packages/shared && tsc -p packages/agents && tsc -p packages/tools && tsc -p apps/hub && tsc -p apps/runner && bun run --cwd apps/web typecheck",
    "db:generate": "bun run --cwd apps/hub db:generate"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "concurrently": "10.0.6",
    "typescript": "5.9.3"
  }
}
